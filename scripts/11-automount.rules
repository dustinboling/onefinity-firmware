KERNEL!="sd[a-z]*", GOTO="automount_end"
IMPORT{program}="/sbin/blkid -o udev -p %N"
ENV{ID_FS_TYPE}=="", GOTO="automount_end"
# Use the *encoded* label (audit Scripts-15): ID_FS_LABEL_ENC escapes
# characters such as "/" and ".." as \xNN sequences, so a hostile or
# odd filesystem label cannot steer the root-run mount point outside
# /media.  Labels without an encoded form fall back to usb-%k.
ENV{ID_FS_LABEL_ENC}!="", ENV{dir_name}="%E{ID_FS_LABEL_ENC}"
ENV{ID_FS_LABEL_ENC}=="", ENV{dir_name}="usb-%k"
# Mount removable media defensively (Scripts-15): never honour
# setuid binaries, device nodes or executables from the stick.
ACTION=="add", ENV{mount_options}="nosuid,nodev,noexec,relatime"
ACTION=="add", ENV{ID_FS_TYPE}=="vfat|ntfs", ENV{mount_options}="$env{mount_options},utf8,gid=100,umask=002,sync"
ACTION=="add", RUN+="/bin/mkdir -p /media/%E{dir_name}", RUN+="/bin/mount -o $env{mount_options} /dev/%k /media/%E{dir_name}"
ACTION=="remove", ENV{dir_name}!="", RUN+="/bin/umount -l /media/%E{dir_name}", RUN+="/bin/rmdir /media/%E{dir_name}"
LABEL="automount_end"
